{
  "description": "Modify a task; writes audit.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "assignees": {
        "description": "workspace user refs to assign",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "clear": {
        "description": "fields to clear: project, priority, description, due, wait, scheduled, until, assignees, or uda.\u003cname\u003e",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "clear_depends": {
        "description": "remove all dependency links",
        "type": "boolean"
      },
      "depends": {
        "description": "task refs to add as dependencies (appended, deduped)",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "description": {
        "description": "new task details; pass empty string to clear",
        "type": [
          "null",
          "string"
        ]
      },
      "due": {
        "description": "new deadline time, unix seconds",
        "type": [
          "null",
          "integer"
        ]
      },
      "due_date": {
        "description": "deadline date as YYYY-MM-DD; stored at local 23:59:59",
        "type": "string"
      },
      "id": {
        "description": "task reference: UUID, materialized task_slug, or occurrence_ref; projected occurrences only have occurrence_ref",
        "type": "string"
      },
      "priority": {
        "description": "new task priority: H, M, or L; omit to leave unchanged",
        "type": [
          "null",
          "string"
        ]
      },
      "project": {
        "description": "project slug in the effective workspace",
        "type": "string"
      },
      "project_id": {
        "description": "stable project UUID",
        "type": "string"
      },
      "remove_assignees": {
        "description": "workspace user refs to unassign",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "remove_tags": {
        "description": "task tags to remove",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "scheduled": {
        "description": "new scheduled start time, unix seconds",
        "type": [
          "null",
          "integer"
        ]
      },
      "scheduled_date": {
        "description": "scheduled start date as YYYY-MM-DD; stored at local 00:00:00",
        "type": "string"
      },
      "tags": {
        "description": "task tags to add",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "title": {
        "description": "new task title",
        "type": [
          "null",
          "string"
        ]
      },
      "udas": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "user-defined attribute overrides",
        "type": "object"
      },
      "until": {
        "description": "new effective-until time, unix seconds",
        "type": [
          "null",
          "integer"
        ]
      },
      "until_date": {
        "description": "effective-until date as YYYY-MM-DD; stored at local 23:59:59",
        "type": "string"
      },
      "wait": {
        "description": "new defer-until time, unix seconds",
        "type": [
          "null",
          "integer"
        ]
      },
      "wait_date": {
        "description": "defer-until date as YYYY-MM-DD; stored at local 00:00:00",
        "type": "string"
      },
      "workspace": {
        "description": "workspace slug or UUID; omit to use the actor's default workspace",
        "type": "string"
      }
    },
    "required": [
      "id"
    ],
    "type": "object"
  },
  "name": "task_modify",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "data": true,
      "rendered": {
        "type": "string"
      }
    },
    "required": [
      "data",
      "rendered"
    ],
    "type": "object"
  }
}