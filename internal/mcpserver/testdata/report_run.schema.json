{
  "description": "Run a task report; read-only.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "due_after": {
        "description": "YYYY-MM-DD",
        "type": "string"
      },
      "due_before": {
        "description": "YYYY-MM-DD",
        "type": "string"
      },
      "limit": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "occurrence_mode": {
        "description": "auto|materialized|expand",
        "type": "string"
      },
      "offset": {
        "type": "integer"
      },
      "project": {
        "type": "string"
      },
      "project_id": {
        "type": "string"
      },
      "query": {
        "type": "string"
      },
      "sort": {
        "type": "string"
      },
      "task_type": {
        "description": "all|normal|occurrence",
        "type": "string"
      },
      "workspace": {
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "type": "object"
  },
  "name": "report_run",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "data": true,
      "rendered": {
        "type": "string"
      }
    },
    "required": [
      "data",
      "rendered"
    ],
    "type": "object"
  }
