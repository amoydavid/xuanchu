{
  "description": "Run a task report; read-only.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "due_after": {
        "description": "YYYY-MM-DD",
        "type": "string"
      },
      "due_before": {
        "description": "YYYY-MM-DD",
        "type": "string"
      },
      "limit": {
        "description": "max tasks to return (default 200)",
        "type": "integer"
      },
      "name": {
        "description": "report name, e.g. active, blocked, due, overdue, upcoming",
        "type": "string"
      },
      "occurrence_mode": {
        "description": "auto|materialized|expand",
        "type": "string"
      },
      "offset": {
        "description": "number of tasks to skip",
        "type": "integer"
      },
      "project": {
        "description": "project slug in the effective workspace",
        "type": "string"
      },
      "project_id": {
        "description": "stable project UUID",
        "type": "string"
      },
      "query": {
        "description": "task filter expression",
        "type": "string"
      },
      "sort": {
        "description": "task sort expression, for example due, due-, urgency-",
        "type": "string"
      },
      "task_type": {
        "description": "all|normal|occurrence",
        "type": "string"
      },
      "workspace": {
        "description": "workspace slug or UUID; omit to use the actor's default workspace",
        "type": "string"
      }
    },
    "required": [
      "name"
    ],
    "type": "object"
  },
  "name": "report_run",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "data": true,
      "rendered": {
        "type": "string"
      }
    },
    "required": [
      "data",
      "rendered"
    ],
    "type": "object"
  }
}