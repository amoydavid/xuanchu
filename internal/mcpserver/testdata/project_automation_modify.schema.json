{
  "description": "Modify a project automation rule; omitted fields stay unchanged.",
  "inputSchema": {
    "additionalProperties": false,
    "anyOf": [
      {
        "required": [
          "project"
        ]
      },
      {
        "required": [
          "project_id"
        ]
      }
    ],
    "properties": {
      "action": {
        "additionalProperties": false,
        "description": "new OpenAI-compatible delivery action",
        "properties": {
          "allowed_hosts_config_key": {
            "description": "scoped config key holding the JSON host allowlist (default agent.provider.allowed_hosts)",
            "type": "string"
          },
          "api_key_config_key": {
            "description": "scoped config key holding the provider API key",
            "type": "string"
          },
          "attach_metadata": {
            "description": "attach xuanchu source metadata to the request body",
            "type": "boolean"
          },
          "base_url_config_key": {
            "description": "scoped config key holding the provider base URL",
            "type": "string"
          },
          "max_attempts": {
            "description": "max delivery attempts including retries (default 5)",
            "type": "integer"
          },
          "model_config_key": {
            "description": "scoped config key holding the model name (or use model_override)",
            "type": "string"
          },
          "model_override": {
            "description": "fixed model name, bypassing model_config_key",
            "type": "string"
          },
          "protocol": {
            "description": "delivery protocol, only chat_completions (default)",
            "type": "string"
          },
          "temperature": {
            "description": "sampling temperature (default 0.2)",
            "type": "number"
          }
        },
        "required": [
          "base_url_config_key",
          "api_key_config_key"
        ],
        "type": [
          "null",
          "object"
        ]
      },
      "condition": {
        "additionalProperties": false,
        "description": "new task filter and event conditions",
        "properties": {
          "max_tasks": {
            "description": "max tasks included in delivery context (default 50)",
            "type": "integer"
          },
          "only_added_assignees": {
            "description": "for task.assigned events, only fire when assignees were actually added",
            "type": "boolean"
          },
          "task_filter": {
            "description": "task filter applied to the matched task set",
            "type": "string"
          }
        },
        "type": [
          "null",
          "object"
        ]
      },
      "context": {
        "additionalProperties": false,
        "description": "new delivery context include list",
        "properties": {
          "include": {
            "description": "context include keys (legacy; template variables are always filled)",
            "items": {
              "type": "string"
            },
            "type": [
              "null",
              "array"
            ]
          }
        },
        "type": [
          "null",
          "object"
        ]
      },
      "description": {
        "description": "new rule description",
        "type": [
          "null",
          "string"
        ]
      },
      "enabled": {
        "description": "whether the rule is enabled",
        "type": [
          "null",
          "boolean"
        ]
      },
      "instruction_template": {
        "description": "new user message template",
        "type": [
          "null",
          "string"
        ]
      },
      "name": {
        "description": "new rule name",
        "type": [
          "null",
          "string"
        ]
      },
      "project": {
        "description": "project slug in the effective workspace",
        "type": "string"
      },
      "project_id": {
        "description": "stable project UUID",
        "type": "string"
      },
      "rule_id": {
        "description": "automation rule ID",
        "type": "string"
      },
      "system_prompt": {
        "description": "new system prompt template",
        "type": [
          "null",
          "string"
        ]
      },
      "trigger_config": {
        "additionalProperties": false,
        "description": "new trigger configuration",
        "properties": {
          "event_type": {
            "description": "hook event type for event trigger (task.assigned, task.completed, project.transitioned, ...)",
            "type": "string"
          },
          "schedule_type": {
            "description": "schedule trigger type: daily_at or cron",
            "type": "string"
          },
          "schedule_value": {
            "description": "HH:MM for daily_at, or a 5-field cron expression",
            "type": "string"
          },
          "timezone": {
            "description": "IANA timezone for schedule evaluation",
            "type": "string"
          }
        },
        "type": [
          "null",
          "object"
        ]
      },
      "trigger_type": {
        "description": "new trigger type: schedule or event",
        "type": [
          "null",
          "string"
        ]
      },
      "workspace": {
        "description": "workspace slug or UUID; omit to use the actor's default workspace",
        "type": "string"
      }
    },
    "required": [
      "rule_id"
    ],
    "type": "object"
  },
  "name": "project_automation_modify",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "data": true,
      "rendered": {
        "type": "string"
      }
    },
    "required": [
      "data",
      "rendered"
    ],
    "type": "object"
  }
}