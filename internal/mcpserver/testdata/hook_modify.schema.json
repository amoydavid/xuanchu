{
  "description": "Modify a hook; writes audit.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "active": {
        "description": "whether the hook is enabled",
        "type": [
          "null",
          "boolean"
        ]
      },
      "events": {
        "description": "event types that trigger the hook",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "hook": {
        "description": "hook ID",
        "type": "string"
      },
      "name": {
        "description": "new hook name",
        "type": [
          "null",
          "string"
        ]
      },
      "project": {
        "description": "project slug in the effective workspace",
        "type": "string"
      },
      "project_id": {
        "description": "stable project UUID",
        "type": "string"
      },
      "sink": {
        "description": "new notification sink name or ID",
        "type": [
          "null",
          "string"
        ]
      },
      "workspace": {
        "description": "workspace slug or UUID; omit to use the actor's default workspace",
        "type": "string"
      }
    },
    "required": [
      "hook"
    ],
    "type": "object"
  },
  "name": "hook_modify",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "data": true,
      "rendered": {
        "type": "string"
      }
    },
    "required": [
      "data",
      "rendered"
    ],
    "type": "object"
  }
}