{
  "description": "Write workspace or project config; writes audit for shared config.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "key": {
        "description": "config key to write",
        "type": "string"
      },
      "project": {
        "description": "project slug in the effective workspace",
        "type": "string"
      },
      "project_id": {
        "description": "stable project UUID",
        "type": "string"
      },
      "scope": {
        "description": "config scope: workspace, project, or local",
        "type": "string"
      },
      "value": {
        "description": "config value",
        "type": "string"
      },
      "workspace": {
        "description": "workspace slug or UUID; omit to use the actor's default workspace",
        "type": "string"
      }
    },
    "required": [
      "key",
      "value",
      "scope"
    ],
    "type": "object"
  },
  "name": "config_set",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "data": true,
      "rendered": {
        "type": "string"
      }
    },
    "required": [
      "data",
      "rendered"
    ],
    "type": "object"
  }
}