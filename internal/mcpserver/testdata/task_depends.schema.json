{
  "description": "Adjust task dependencies; writes audit.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "clear_depends": {
        "description": "remove all dependency links",
        "type": "boolean"
      },
      "depends": {
        "description": "task refs this task depends on (replaces existing)",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "id": {
        "description": "task reference: UUID, materialized task_slug, or occurrence_ref; projected occurrences only have occurrence_ref",
        "type": "string"
      },
      "project": {
        "description": "project slug in the effective workspace",
        "type": "string"
      },
      "project_id": {
        "description": "stable project UUID",
        "type": "string"
      },
      "workspace": {
        "description": "workspace slug or UUID; omit to use the actor's default workspace",
        "type": "string"
      }
    },
    "required": [
      "id"
    ],
    "type": "object"
  },
  "name": "task_depends",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "data": true,
      "rendered": {
        "type": "string"
      }
    },
    "required": [
      "data",
      "rendered"
    ],
    "type": "object"
  }
}