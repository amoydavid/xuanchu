{
  "description": "Query tasks; read-only. Defaults to all non-deleted tasks unless status is explicit.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "due_after": {
        "description": "YYYY-MM-DD",
        "type": "string"
      },
      "due_before": {
        "description": "YYYY-MM-DD",
        "type": "string"
      },
      "include_deleted": {
        "description": "include deleted tasks in addition to the default non-deleted set; ignored when status is explicit",
        "type": "boolean"
      },
      "limit": {
        "type": "integer"
      },
      "occurrence_mode": {
        "description": "auto|materialized|expand",
        "type": "string"
      },
      "offset": {
        "type": "integer"
      },
      "project": {
        "type": "string"
      },
      "project_id": {
        "type": "string"
      },
      "query": {
        "description": "task filter expression; an explicit status predicate overrides default visibility",
        "type": "string"
      },
      "sort": {
        "description": "task sort expression, for example due, due-, urgency-",
        "type": "string"
      },
      "status": {
        "description": "explicit task status filter; overrides default non-deleted visibility",
        "type": "string"
      },
      "task_type": {
        "description": "all|normal|occurrence",
        "type": "string"
      },
      "workspace": {
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "task_query",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "data": true,
      "rendered": {
        "type": "string"
      }
    },
    "required": [
      "data",
      "rendered"
    ],
    "type": "object"
  }
}