{
  "description": "Modify a recurring task series (shared fields; rule change requires effective_from).",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "assignees": {
        "description": "replace assignee user refs on each occurrence",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "clear": {
        "description": "fields to clear: title, description, priority, assignees, tags, udas, until",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "description": {
        "description": "new series details; pass empty string to clear",
        "type": [
          "null",
          "string"
        ]
      },
      "effective_from": {
        "description": "rule-change effective time, unix seconds",
        "type": [
          "null",
          "integer"
        ]
      },
      "effective_from_date": {
        "description": "rule-change effective date as YYYY-MM-DD; stored at local 00:00:00",
        "type": [
          "null",
          "string"
        ]
      },
      "id": {
        "description": "series UUID",
        "type": "string"
      },
      "priority": {
        "description": "new task priority: H, M, or L",
        "type": [
          "null",
          "string"
        ]
      },
      "recurrence_rule": {
        "description": "new recurrence rule; requires effective_from",
        "type": [
          "null",
          "string"
        ]
      },
      "tags": {
        "description": "replace tags on each occurrence",
        "items": {
          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "title": {
        "description": "new series title",
        "type": [
          "null",
          "string"
        ]
      },
      "udas": {
        "additionalProperties": {
          "type": "string"
        },
        "description": "replace user-defined attributes on each occurrence",
        "type": "object"
      },
      "until": {
        "description": "new series end time, unix seconds",
        "type": [
          "null",
          "integer"
        ]
      },
      "until_date": {
        "description": "new series end date as YYYY-MM-DD; stored at local 23:59:59",
        "type": [
          "null",
          "string"
        ]
      },
      "workspace": {
        "description": "workspace slug or UUID; omit to use the actor's default workspace",
        "type": "string"
      }
    },
    "required": [
      "id"
    ],
    "type": "object"
  },
  "name": "task_series_modify",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "data": true,
      "rendered": {
        "type": "string"
      }
    },
    "required": [
      "data",
      "rendered"
    ],
    "type": "object"
  }
}