{
  "description": "List recurring task series.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "assignee": {
        "description": "filter by assignee user ref",
        "type": "string"
      },
      "limit": {
        "default": 200,
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
      },
      "offset": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
      },
      "project": {
        "description": "project slug in the effective workspace",
        "type": "string"
      },
      "project_id": {
        "description": "stable project UUID",
        "type": "string"
      },
      "q": {
        "description": "free-text filter on series title",
        "type": "string"
      },
      "sort": {
        "description": "sort expression, e.g. title, due-",
        "type": "string"
      },
      "status": {
        "description": "filter by series status: active or stopped",
        "type": "string"
      },
      "workspace": {
        "description": "workspace slug or UUID; omit to use the actor's default workspace",
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "task_series_list",
  "outputSchema": {
    "additionalProperties": false,
    "properties": {
      "data": true,
      "rendered": {
        "type": "string"
      }
    },
    "required": [
      "data",
      "rendered"
    ],
    "type": "object"
  }
}