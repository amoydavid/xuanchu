  "inputSchema": {
    "additionalProperties": false,
    "anyOf": [
      {
        "required": [
          "project"
        ]
      },
      {
        "required": [
          "project_id"
        ]
      }
    ],
    "properties": {
      "limit": {
        "description": "max timeline entries to return (default 20)",
        "type": "integer"
      },
      "offset": {
