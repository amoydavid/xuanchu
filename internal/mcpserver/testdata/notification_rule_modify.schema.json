{
  "description": "Modify an event notification rule; writes audit.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "audience": {
        "description": "new audience: actor, assignees, explicit_users, or assignees_and_explicit_users",
        "type": [
          "null",
          "string"
        ]
      },
      "event": {
        "description": "new event type",
        "type": [
          "null",
          "string"
        ]
      },
      "filter": {
        "description": "new task filter expression for task events",
        "type": [
          "null",
          "string"
        ]
      },
      "name": {
        "description": "new rule name",
        "type": [
          "null",
          "string"
        ]
      },
      "project": {
        "description": "project slug in the effective workspace",
        "type": "string"
      },
      "project_id": {
        "description": "stable project UUID",
        "type": "string"
      },
      "project_ref": {
        "description": "new rule project scope; empty clears project scope",
        "type": [
          "null",
          "string"
        ]
      },
      "recipients": {
        "description": "new explicit recipient user refs",
