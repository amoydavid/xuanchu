          "type": "string"
        },
        "type": [
          "null",
          "array"
        ]
      },
      "rule": {
        "description": "notification rule ID",
        "type": "string"
      },
      "sink": {
        "description": "notification sink name or ID",
        "type": [
          "null",
          "string"
        ]
      },
      "template_body": {
        "description": "new rendered notification body template",
        "type": [
          "null",
          "string"
        ]
      },
      "template_subject": {
        "description": "new rendered notification subject template",
        "type": [
          "null",
          "string"
        ]
      },
